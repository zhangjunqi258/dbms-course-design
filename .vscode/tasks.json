{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build dbms",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++11",
                "-Wall",
                "-Wextra",
                "-O2",
                "-o",
                "dbms.exe",
                "src/main.cpp",
                "src/storage.cpp",
                "src/sql.cpp"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
